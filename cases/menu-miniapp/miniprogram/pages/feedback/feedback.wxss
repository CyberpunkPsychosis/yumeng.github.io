.fbhero{margin:24rpx 24rpx;padding:30rpx;border-radius:24rpx;color:#fff;font-size:28rpx;background:var(--accent)}
.cmtcard{background:var(--card);margin:16rpx 24rpx 0;border-radius:20rpx;padding:28rpx}
.cmtcard .cl{font-size:25rpx;color:var(--muted);margin-bottom:20rpx}
.ftags{display:flex;flex-wrap:wrap;gap:16rpx}
.ftag{font-size:25rpx;color:var(--muted);border:1rpx solid var(--line);border-radius:999rpx;padding:12rpx 26rpx}
.ftag.on{border-color:var(--accent);color:var(--accent);background:rgba(0,0,0,.03)}
.rvinput{width:100%;height:200rpx;font-size:28rpx;line-height:1.6}
.fbline{width:100%;font-size:28rpx;height:60rpx}
.cobar{padding:28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom))}
