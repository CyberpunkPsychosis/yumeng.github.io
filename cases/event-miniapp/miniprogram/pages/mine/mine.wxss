.profile{display:flex;align-items:center;gap:24rpx;padding:36rpx 28rpx;background:#fff}
.profile .pav{width:108rpx;height:108rpx;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:48rpx}
.profile .pn{font-weight:700;font-size:34rpx}.profile .ps{font-size:24rpx;color:#8a948a;margin-top:6rpx}
.profile .loginbtn{margin-left:auto;font-size:26rpx;font-weight:600;color:#fff;background:#07c160;border-radius:999rpx;padding:14rpx 30rpx;line-height:1.4}
.profile .loginbtn::after{border:none}
.msec{font-size:28rpx;font-weight:700;padding:28rpx 28rpx 12rpx}
.mlist{padding:0 24rpx}
.mrow{display:flex;align-items:center;gap:20rpx;background:#fff;border:1rpx solid #ececea;border-radius:20rpx;padding:18rpx;margin-bottom:16rpx}
.mrow image{width:112rpx;height:112rpx;border-radius:16rpx;flex:0 0 auto;background:#f1f3f0}
.mrow .mi{flex:1;min-width:0}.mrow .mi .t{font-weight:600;font-size:27rpx}.mrow .mi .m{font-size:23rpx;color:#8a948a;margin-top:8rpx}
.mrow .mbadge{font-size:21rpx;color:var(--accent);background:rgba(0,0,0,.04);padding:6rpx 16rpx;border-radius:999rpx;flex:0 0 auto}
.mini-empty{font-size:24rpx;color:#8a948a;padding:14rpx 6rpx}
.tools{display:grid;grid-template-columns:repeat(4,1fr);gap:28rpx 0;padding:14rpx 24rpx 48rpx}
.tool{display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:22rpx;color:#485045}
.tool .tic{font-size:40rpx;color:var(--accent)}
