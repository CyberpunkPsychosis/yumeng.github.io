page{font-family:-apple-system,"PingFang SC",sans-serif;background:#f4f6f3;color:#1d231b}
.root{min-height:100vh;padding-bottom:120rpx}
.price{color:var(--accent);font-weight:700}
.tag{font-size:21rpx;color:var(--accent);background:rgba(0,0,0,.04);border-radius:8rpx;padding:2rpx 12rpx;margin-right:8rpx}
.btn{color:#fff;background:var(--accent);border-radius:999rpx;text-align:center;font-weight:700;font-size:30rpx;padding:24rpx 0}
.btn[disabled]{background:#bcc4bb}

/* 活动卡片（home/list/mine 复用） */
.card{background:#fff;border:1rpx solid #ececea;border-radius:28rpx;overflow:hidden;margin-bottom:24rpx}
.cover{position:relative}
.cover image{width:100%;height:320rpx;display:block;background:#f1f3f0}
.cover .hot{position:absolute;top:18rpx;left:18rpx;background:rgba(0,0,0,.55);color:#fff;font-size:21rpx;padding:5rpx 16rpx;border-radius:999rpx}
.cover .cprice{position:absolute;bottom:18rpx;right:18rpx;background:var(--accent);color:#fff;font-size:24rpx;font-weight:700;padding:7rpx 22rpx;border-radius:999rpx}
.cbody{padding:22rpx 24rpx 24rpx}
.ctitle{font-size:30rpx;font-weight:700;line-height:1.35}
.corg{display:flex;align-items:center;gap:10rpx;font-size:22rpx;color:#8a948a;margin-top:14rpx}
.obadge{width:36rpx;height:36rpx;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:20rpx}
.cmeta{font-size:23rpx;color:#5b635a;margin-top:10rpx}
.cfoot{display:flex;align-items:center;margin-top:18rpx}
.avs{display:flex;align-items:center;flex:1}
.av{width:42rpx;height:42rpx;border-radius:50%;background:#cfe6d6;border:3rpx solid #fff;margin-left:-12rpx;display:flex;align-items:center;justify-content:center;font-size:20rpx;color:#2c6b46}
.av.more{background:#e6ebe6;color:#5b635a}
.avtx{font-size:21rpx;color:#8a948a;margin-left:14rpx}
.join{background:rgba(0,0,0,.04);color:var(--accent);font-weight:700;font-size:24rpx;padding:12rpx 28rpx;border-radius:999rpx}

/* 在页登录门 */
.logingate{margin:40rpx 28rpx;padding:56rpx 36rpx;border-radius:24rpx;background:#fff;border:1rpx solid #ececea;text-align:center}
.logingate .lg-ic{font-size:64rpx}.logingate .lg-t{font-weight:700;font-size:32rpx;margin-top:20rpx}
.logingate .lg-s{font-size:25rpx;color:#8a948a;margin:14rpx 0 36rpx;line-height:1.6}
.wxbtn{width:100%;font-size:30rpx;font-weight:600;color:#fff;background:#07c160;border-radius:18rpx;padding:24rpx 0}
.wxbtn::after{border:none}
