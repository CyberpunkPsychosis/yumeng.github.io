.page{
  position:relative;height:100vh;overflow:hidden;
  background:
    radial-gradient(120% 70% at 80% 8%, rgba(255,246,225,.85), transparent 55%),
    radial-gradient(140% 90% at 15% 100%, rgba(150,116,77,.45), transparent 55%),
    linear-gradient(160deg,#e9dcc1,#d8c39d 60%,#c9b288);
}

/* 背景大字 */
.ghost{
  position:absolute;top:150rpx;left:-12rpx;right:-12rpx;
  font-weight:700;font-size:184rpx;line-height:.92;letter-spacing:-4rpx;
  color:rgba(90,59,39,.07);
}

/* 标题 */
.head{padding:40rpx 56rpx 0;display:flex;flex-direction:column;}
.title{font-weight:700;font-size:68rpx;color:#5a3b27;letter-spacing:2rpx;line-height:1.05;}
.title-en{font-family:"EditorialSerif",serif;font-size:30rpx;letter-spacing:10rpx;color:#8a6c4f;margin-top:12rpx;}
.note{font-size:21rpx;color:rgba(90,59,39,.55);margin-top:20rpx;}

/* 产品 */
.product{position:relative;margin-top:12rpx;height:700rpx;display:flex;align-items:center;justify-content:center;}
.price{position:absolute;left:56rpx;top:150rpx;display:flex;flex-direction:column;gap:28rpx;}
.price .p{display:flex;align-items:baseline;}
.price .y{font-family:"EditorialSerif",serif;font-size:52rpx;color:#5a3b27;margin-right:14rpx;}
.price .m{font-size:20rpx;color:#8a6c4f;}
.slab{position:absolute;bottom:96rpx;width:420rpx;height:68rpx;border-radius:28rpx;
  background:linear-gradient(180deg,#cdb78f,#b89a6c);box-shadow:0 16rpx 32rpx rgba(60,40,24,.25);}
.shadow{position:absolute;bottom:108rpx;width:380rpx;height:60rpx;border-radius:50%;background:rgba(60,40,24,.30);filter:blur(8rpx);}
.badge{position:absolute;top:250rpx;width:68rpx;height:68rpx;border:2rpx solid rgba(255,255,255,.85);border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:#fff;font-size:16rpx;letter-spacing:1rpx;}
.cup{position:relative;height:640rpx;width:100%;}

/* 底部导航 */
.dock{position:absolute;left:0;right:0;bottom:60rpx;}
.primary{position:relative;display:flex;align-items:center;justify-content:space-between;padding:0 80rpx 40rpx;}
.pcol{flex:1;display:flex;flex-direction:column;align-items:center;}
.pcol .cn{font-size:32rpx;color:#5a3b27;font-weight:600;letter-spacing:4rpx;}
.pcol .en{font-family:"EditorialSerif",serif;font-style:italic;font-size:22rpx;color:#8a6c4f;margin-top:6rpx;}
.vline{position:absolute;left:50%;top:0;transform:translateX(-50%);width:1rpx;height:92rpx;background:rgba(90,59,39,.28);}
.close{position:absolute;left:50%;bottom:-4rpx;transform:translateX(-50%);width:60rpx;height:60rpx;border:1rpx solid rgba(90,59,39,.28);
  border-radius:50%;display:flex;align-items:center;justify-content:center;color:#5a3b27;font-size:30rpx;background:rgba(231,216,189,.7);}
.sub{display:flex;border-top:1rpx solid rgba(90,59,39,.28);margin:16rpx 52rpx 0;padding-top:28rpx;}
.scol{flex:1;display:flex;flex-direction:column;align-items:center;}
.scol .cn{font-size:26rpx;color:#5a3b27;letter-spacing:2rpx;}
.scol .en{font-family:"EditorialSerif",serif;font-style:italic;font-size:20rpx;color:#8a6c4f;margin-top:4rpx;}
