<view class="root theme-{{mode}}" style="--accent: {{accent}};">
  <view class="wrap">
    <view class="ok">✓</view>
    <text class="t serif">预约提交成功</text>
    <text class="tip">我们会尽快与您联系确认（演示）</text>
    <view class="recap">
      <view class="r" wx:for="{{rows}}" wx:key="k"><text class="k">{{item.k}}</text><text class="v">{{item.v}}</text></view>
    </view>
    <view class="btn back" bindtap="onHome">返回首页</view>
  </view>
</view>
