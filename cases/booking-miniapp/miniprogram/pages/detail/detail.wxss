.dimg{width:100%;height:520rpx;background:var(--soft)}
.dbody{padding:32rpx 36rpx 220rpx}
.tags{display:flex;margin-bottom:8rpx}
.nm{display:block;font-weight:700;font-size:46rpx;margin-top:8rpx}
.pr{display:block;font-size:48rpx;margin:14rpx 0 18rpx}
.pr .u{font-size:24rpx;color:var(--muted);font-weight:400}
.ds{display:block;font-size:28rpx;color:var(--muted);line-height:1.7}
.opt{margin-top:34rpx}
.opt .ol{display:block;font-size:26rpx;color:var(--muted);margin-bottom:16rpx}
.ov{display:flex;flex-wrap:wrap;gap:16rpx}
.o{font-size:27rpx;border:1rpx solid var(--line);background:var(--card);border-radius:16rpx;padding:16rpx 28rpx}
.o.on{border-color:var(--accent);color:var(--accent)}

.actionbar{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;gap:24rpx;
  padding:18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line);background:var(--card)}
.actionbar .meta{flex:1}
.actionbar .price{font-size:44rpx}.actionbar .u{font-size:22rpx;color:var(--muted);font-weight:400}
.actionbar .book{flex:0 0 auto;padding-left:60rpx;padding-right:60rpx}
