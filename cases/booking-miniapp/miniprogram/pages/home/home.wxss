.hero{position:relative;height:560rpx;display:flex;flex-direction:column;justify-content:flex-end;padding:36rpx;color:#fff;background-size:cover;background-position:center}
.hero::after{content:"";position:absolute;left:0;right:0;bottom:0;top:0;background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.6))}
.hero-ct{position:relative;z-index:2}
.eyebrow{display:block;font-size:22rpx;letter-spacing:5rpx;color:rgba(255,255,255,.85)}
.htitle{display:block;font-weight:700;font-size:62rpx;line-height:1.1;white-space:pre-line;margin-top:14rpx}
.hsub{display:block;font-size:26rpx;opacity:.9;margin-top:16rpx;max-width:520rpx}

.chips{white-space:nowrap;padding:24rpx 36rpx 8rpx}
.chip{display:inline-block;font-size:27rpx;color:var(--muted);background:var(--card);border:1rpx solid var(--line);border-radius:999rpx;padding:12rpx 28rpx;margin-right:16rpx}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff}

.list{padding:16rpx 36rpx 0;display:flex;flex-direction:column;gap:22rpx}
.card{display:flex;gap:22rpx;background:var(--card);border:1rpx solid var(--line);border-radius:24rpx;padding:18rpx}
.card .th{width:190rpx;height:190rpx;border-radius:18rpx;flex:0 0 auto;background:var(--soft)}
.card .info{flex:1;display:flex;flex-direction:column;min-width:0}
.card .nm{font-weight:600;font-size:32rpx}
.card .ds{font-size:24rpx;color:var(--muted);margin:8rpx 0 12rpx;overflow:hidden}
.card .bot{margin-top:auto;display:flex;align-items:center;justify-content:space-between}
.card .price{font-size:36rpx}.card .u{font-size:22rpx;color:var(--muted);font-weight:400}

.sec{padding:36rpx}
.sec .h{display:block;font-weight:700;font-size:38rpx;margin-bottom:24rpx}
.steps{display:flex;flex-direction:column}
.step{display:flex;gap:22rpx;align-items:flex-start;position:relative;padding-bottom:32rpx}
.step:not(:last-child)::before{content:"";position:absolute;left:28rpx;top:58rpx;bottom:0;width:1rpx;background:var(--line)}
.step .n{width:56rpx;height:56rpx;flex:0 0 56rpx;border-radius:50%;background:var(--accent);color:#fff;text-align:center;line-height:56rpx;font-weight:600;z-index:1}
.step .st{display:block;font-weight:600;font-size:30rpx}
.step .sd{display:block;font-size:24rpx;color:var(--muted);margin-top:4rpx}

.contact{margin:0 36rpx 60rpx;background:var(--card);border:1rpx solid var(--line);border-radius:24rpx;overflow:hidden}
.contact .r{display:flex;justify-content:space-between;padding:26rpx 30rpx;border-top:1rpx solid var(--line);font-size:28rpx}
.contact .r:first-child{border-top:none}
.contact .r .k{color:var(--muted)}
.tags{display:flex}
