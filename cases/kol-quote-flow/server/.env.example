# ===== 大模型（可随意切换厂商/模型）=====
# LLM_PROVIDER=anthropic 用 Claude；=openai 用任意「OpenAI 兼容」端点
LLM_PROVIDER=anthropic

# --- 用 Claude 时 ---
ANTHROPIC_API_KEY=sk-ant-xxxx
# 默认 claude-opus-4-8（最准）；高并发降本可换 claude-sonnet-4-6 / claude-haiku-4-5
LLM_MODEL=claude-opus-4-8

# --- 用 OpenAI 兼容端点时（取消注释并填好）---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
#   覆盖示例：
#   DeepSeek     LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
#   通义千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   Moonshot     LLM_BASE_URL=https://api.moonshot.cn/v1            LLM_MODEL=moonshot-v1-8k
#   智谱GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-flash

# ===== 抽取模板（抽哪些字段）=====
# 内置 kol-quote；加新行业在 server/templates/ 里加一个文件并登记
TEMPLATE=kol-quote

# ===== Gmail（拉报价邮件，只读）=====
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxx
GMAIL_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GMAIL_REFRESH_TOKEN=xxxx
GMAIL_LABEL=KOL报价

# ===== 飞书（写多维表格）=====
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_APP_TOKEN=bascnxxxx
FEISHU_TABLE_ID=tblxxxx
# 海外飞书(Lark)改 https://open.larksuite.com/open-apis
FEISHU_BASE=https://open.feishu.cn/open-apis

# ===== 运行 =====
PORT=8787
POLL_INTERVAL_MS=300000
STORE_FILE=./data/records.json
