# ===== 大模型（AI 抽取）=====
ANTHROPIC_API_KEY=sk-ant-xxxx
# 模型：默认 claude-opus-4-8（最准）。高并发/降本可换：
#   claude-sonnet-4-6（均衡）/ claude-haiku-4-5（最便宜最快）。成本见 README。
MODEL=claude-opus-4-8

# ===== Gmail（拉报价邮件，只读）=====
GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=xxxx
GMAIL_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GMAIL_REFRESH_TOKEN=xxxx
# 只处理打了这个标签的邮件（在 Gmail 里给报价信打标签）
GMAIL_LABEL=KOL报价

# ===== 飞书（写多维表格）=====
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_APP_TOKEN=bascnxxxx      # 多维表格 Base 的 app_token
FEISHU_TABLE_ID=tblxxxx         # 目标数据表 table_id
# 海外飞书(Lark)改为 https://open.larksuite.com/open-apis
FEISHU_BASE=https://open.feishu.cn/open-apis

# ===== 运行 =====
PORT=8787
POLL_INTERVAL_MS=300000         # 轮询间隔，默认 5 分钟
STORE_FILE=./data/records.json
