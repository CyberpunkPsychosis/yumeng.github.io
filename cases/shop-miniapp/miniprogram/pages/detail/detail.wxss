.dimg{width:100%;height:750rpx;background:var(--soft)}
.dinfo{background:var(--card);padding:30rpx}
.dp{display:flex;align-items:baseline}
.dp .p{font-size:52rpx;margin-right:16rpx}
.dp .ref{font-size:24rpx;color:var(--muted);text-decoration:line-through;margin-right:16rpx}
.dt{font-size:30rpx;margin-top:16rpx;line-height:1.5}
.dbr{font-size:24rpx;color:var(--muted);margin-top:8rpx}
.opt{background:var(--card);margin-top:16rpx;padding:26rpx 30rpx}
.opt .ol{font-size:24rpx;color:var(--muted);margin-bottom:18rpx}
.ov{display:flex;flex-wrap:wrap;gap:16rpx}
.o{font-size:26rpx;border:1rpx solid var(--line);border-radius:14rpx;padding:14rpx 28rpx}
.o.on{border-color:var(--accent);color:var(--accent)}
.note{display:flex;justify-content:space-between;background:var(--card);margin-top:16rpx;padding:28rpx 30rpx;font-size:26rpx;color:var(--muted)}
.ddesc{padding:30rpx;font-size:28rpx;color:var(--muted);line-height:1.7;padding-bottom:180rpx}
.actionbar{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:center;gap:10rpx;padding:14rpx 22rpx calc(14rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line);background:var(--card)}
.icobtn{display:flex;flex-direction:column;align-items:center;font-size:20rpx;color:var(--muted);width:96rpx;position:relative}
.icobtn .ic{font-size:38rpx}
.icobtn .badge{position:absolute;top:-6rpx;right:14rpx;background:#e0523b;color:#fff;font-size:18rpx;min-width:26rpx;height:26rpx;line-height:26rpx;border-radius:13rpx;padding:0 5rpx}
.grow{flex:1}
.addbtn{flex:0 0 auto;padding-left:64rpx;padding-right:64rpx}
