<view class="root theme-{{mode}}" style="--accent: {{accent}};">
  <image class="dimg" src="{{p.thumb}}" mode="aspectFill" />
  <view class="dinfo">
    <view class="dp"><text class="price p">¥{{p.price}}</text><text wx:if="{{p.refPrice}}" class="ref">¥{{p.refPrice}}</text><text wx:if="{{p.tag}}" class="tag">{{p.tag}}</text></view>
    <view class="dt">{{p.title}}</view>
    <view class="dbr">{{p.brand}}</view>
  </view>

  <view class="opt" wx:for="{{p.specs}}" wx:key="label" wx:for-item="o">
    <text class="ol">{{o.label}}</text>
    <view class="ov">
      <view class="o {{sel[o.label] === v ? 'on' : ''}}" wx:for="{{o.values}}" wx:for-item="v" wx:key="*this" data-label="{{o.label}}" data-val="{{v}}" bindtap="onSpec">{{v}}</view>
    </view>
  </view>

  <view class="note"><text>发货 / 验货说明</text><text>›</text></view>
  <view class="ddesc">{{p.desc}}</view>

  <view class="actionbar">
    <view class="icobtn" bindtap="toHome"><text class="ic">🏠</text>首页</view>
    <view class="icobtn" bindtap="toCart"><text class="ic">🛒</text>购物车<text wx:if="{{count}}" class="badge">{{count}}</text></view>
    <view class="grow"></view>
    <view class="btn addbtn" bindtap="onAdd">加入购物车</view>
  </view>
</view>
