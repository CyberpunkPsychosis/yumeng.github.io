<view class="root theme-{{mode}}" style="--accent: {{accent}};">
  <view class="addr"><text class="pin">📍</text><view class="ai"><view class="n">张先生　138****0000</view><view class="d">上海市徐汇区安福路 300 号</view></view><text class="arr">›</text></view>

  <view class="card">
    <view class="coli" wx:for="{{items}}" wx:key="title">
      <image src="{{item.thumb}}" mode="aspectFill" />
      <view class="ct"><view class="t">{{item.title}}</view><view class="m">{{item.specText}} ×{{item.qty}}</view></view>
      <text class="price p">¥{{item.price}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sumrow"><text>商品金额</text><text>¥{{total}}</text></view>
    <view class="sumrow"><text>运费</text><text>包邮</text></view>
    <view class="sumrow big"><text>合计</text><text class="price p">¥{{total}}</text></view>
  </view>

  <view style="height:140rpx"></view>
  <view class="cobar"><view class="tot">应付 <text class="price p">¥{{total}}</text></view><view class="grow"></view><view class="btn paybtn" bindtap="pay">提交订单</view></view>
</view>
