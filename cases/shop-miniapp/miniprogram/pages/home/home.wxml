<view class="root theme-{{mode}}" style="--accent: {{accent}};">
  <view class="searchbar">
    <view class="ico nic nic-scan"></view>
    <view class="box"><view class="nic nic-search box-ic"></view><text>{{cfg.searchPlaceholder}}</text><text class="go">搜索</text></view>
    <view class="ico nic nic-grid"></view>
  </view>

  <view class="banner" style="background: {{cfg.banner.color}}">
    <view><text class="bt">{{cfg.banner.text}}</text><text class="bs">{{cfg.banner.sub}}</text></view>
    <text class="arr">›</text>
  </view>

  <view wx:if="{{cfg.sell}}" class="sellentry" bindtap="toSell">
    <text class="se-ic">♻️</text>
    <view class="se-tx"><text class="se-t">{{cfg.sell.entryText}}</text><text class="se-s">{{cfg.sell.entrySub}}</text></view>
    <text class="se-go">去估价 ›</text>
  </view>

  <scroll-view class="chips" scroll-x>
    <view class="chip {{item.id === cat ? 'on' : ''}}" wx:for="{{cfg.categories}}" wx:key="id" data-cat="{{item.id}}" bindtap="onCat">{{item.name}}</view>
  </scroll-view>

  <view class="grid">
    <view class="gcard" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <image class="gimg" src="{{item.thumb}}" mode="aspectFill" lazy-load />
      <view class="gb">
        <view class="gt">{{item.title}}</view>
        <view class="gbr">{{item.brand}}</view>
        <view class="gp"><text class="price p">¥{{item.price}}</text><text wx:if="{{item.refPrice}}" class="ref">¥{{item.refPrice}}</text></view>
        <view wx:if="{{item.tag}}" class="gtag"><text class="tag">{{item.tag}}</text></view>
      </view>
    </view>
  </view>

  <view style="height:120rpx"></view>
  <view class="tabbar">
    <view class="t on"><view class="ic nic acc nic-home"></view>首页</view>
    <view class="t"><view class="ic nic nic-grid"></view>分类</view>
    <view class="t" bindtap="toCart"><view class="ic nic nic-cart"></view>购物车<text wx:if="{{count}}" class="badge">{{count}}</text></view>
    <view class="t"><view class="ic nic nic-user"></view>我的</view>
  </view>
</view>
